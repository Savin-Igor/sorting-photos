{
    "name": "igors/sorting-photos-by-date",
    "type": "package",
    "description":"Sorting Photos By Date",
    "license": ["MIT"],
    "authors": [
        {
            "name": "Igors Savins",
            "email": "igor.savin@inbox.lv"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^3.0",
        "doctrine/doctrine-bundle": "^2.0",
        "doctrine/orm": "^3.0",
        "google/auth": "^1.49",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "james-heinrich/getid3": "^2.0",
        "league/flysystem": "^3.0",
        "league/flysystem-local": "^3.0",
        "league/mime-type-detection": "^1.0",
        "monolog/monolog": "^3.0",
        "nesbot/carbon": "^3.0",
        "predis/predis": "^2.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/finder": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/redis-messenger": "^7.3",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpro/grumphp": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.2",
        "sebastian/phpcpd": "^6.0",
        "squizlabs/php_codesniffer": "^3.9",
        "vimeo/psalm": "^6.12"
    },
    "autoload": {
        "psr-4": {
            "SortingPhotosByDate\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SortingPhotosByDate\\Tests\\": "tests/src"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpro/grumphp": true
        }
    }
}
