# Application Configuration
SOURCE_DIRECTORY=/tmp/source
DESTINATION_DIRECTORY=/tmp/destination
ORGANIZER_POLICY=DateTypePolicy
DRY_RUN=false

# Filesystem Configuration
FILESYSTEM_LOCAL_ROOT=/
FILESYSTEM_DEFAULT_DIR_PERMISSIONS=493

# Messenger Configuration
MESSENGER_TRANSPORT_DSN=doctrine://default

# Messenger Retry Strategy Configuration
MESSENGER_MAX_RETRIES=3
MESSENGER_RETRY_DELAY=1000
MESSENGER_RETRY_MULTIPLIER=2.0
MESSENGER_RETRY_MAX_DELAY=60000
