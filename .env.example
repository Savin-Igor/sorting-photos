# ============================================
# Docker User Configuration
# ============================================

# User ID and Group ID for Docker container (should match host user)
# Run: id -u && id -g to get your UID and GID
# If not set, defaults to 1000:1000
USER_ID=1000
GROUP_ID=1000

# ============================================
# Application Configuration
# ============================================

# Source directory path INSIDE container (after volume mount)
# This is the path where files will be read from
# Default: /var/data/source
SOURCE_DIRECTORY=/var/data/source

# Destination directory path INSIDE container (after volume mount)
# This is where organized files will be written
# Default: /var/data/destination
DESTINATION_DIRECTORY=/var/data/destination

# ============================================
# Docker Volume Mounts (Host Paths)
# ============================================

# Source directory path on HOST - can be any path (USB drive, network share, etc.)
# Format: /host/path:/container/path:ro
# Examples:
#   SOURCE_DIRECTORY_HOST=/home/user/Pictures:/var/data/source:ro
#   SOURCE_DIRECTORY_HOST=/mnt/usb/photos:/var/data/source:ro
#   SOURCE_DIRECTORY_HOST=/media/external:/var/data/source:ro
# Default: ./var/data/source:/var/data/source:ro
SOURCE_DIRECTORY_HOST=./var/data/source:/var/data/source:ro

# Destination directory path on HOST - can be any path
# Format: /host/path:/container/path
# Examples:
#   DESTINATION_DIRECTORY_HOST=/mnt/external:/var/data/destination
#   DESTINATION_DIRECTORY_HOST=/home/user/Sorted:/var/data/destination
# Default: ./var/data/destination:/var/data/destination
DESTINATION_DIRECTORY_HOST=./var/data/destination:/var/data/destination

# ============================================
# Organization Policy
# ============================================

# Organization policy: date-type, date, or type-date
ORGANIZER_POLICY=date-type

# Dry-run mode: true or false
DRY_RUN=false

# ============================================
# Filesystem Configuration
# ============================================

# For Docker: use /var/www/html
# For local development: use /
FILESYSTEM_LOCAL_ROOT=/var/www/html

# Directory permissions (octal): 0755 = 493 decimal
FILESYSTEM_DEFAULT_DIR_PERMISSIONS=0755

# ============================================
# Messenger Configuration

# Async processing mode: true or false
# When true, messages are sent to Redis/RabbitMQ queue for parallel processing
# When false, messages are processed synchronously (one by one)
# Default: true
ASYNC_MODE=true

# ============================================

# For Docker with Redis (default):
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# For Docker with RabbitMQ (uncomment when using RabbitMQ profile):
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

# For local development (without Docker):
# MESSENGER_TRANSPORT_DSN=doctrine://default

# ============================================
# Messenger Retry Strategy Configuration
# ============================================

MESSENGER_MAX_RETRIES=3
MESSENGER_RETRY_DELAY=1000
MESSENGER_RETRY_MULTIPLIER=2
MESSENGER_RETRY_MAX_DELAY=10000
