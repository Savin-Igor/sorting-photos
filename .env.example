# ============================================
# Docker User Configuration
# ============================================

# User ID and Group ID for Docker container (should match host user)
# Run: id -u && id -g to get your UID and GID
# If not set, defaults to 1000:1000
USER_ID=1000
GROUP_ID=1000

# ============================================
# Application Configuration
# ============================================

# Source directory path INSIDE container (after volume mount)
# This is the path where files will be read from
# Default: /var/data/source
SOURCE_DIRECTORY=/var/data/source

# Destination directory path INSIDE container (after volume mount)
# This is where organized files will be written
# Default: /var/data/destination
DESTINATION_DIRECTORY=/var/data/destination

# ============================================
# Docker Volume Mounts (Host Paths)
# ============================================

# Source directory path on HOST - can be any path (USB drive, network share, etc.)
# Format: /host/path
# Examples:
#   SOURCE_DIRECTORY_HOST=/home/user/Pictures
#   SOURCE_DIRECTORY_HOST=/mnt/usb/photos
#   SOURCE_DIRECTORY_HOST=/media/external
# Default: ./var/data/source
SOURCE_DIRECTORY_HOST=./var/data/source

# Destination directory path on HOST - can be any path
# Format: /host/path
# Examples:
#   DESTINATION_DIRECTORY_HOST=/mnt/external
#   DESTINATION_DIRECTORY_HOST=/home/user/Sorted
# Default: ./var/data/destination
DESTINATION_DIRECTORY_HOST=./var/data/destination

# Google Photos credentials directory path on HOST
# This directory will be mounted to /var/www/html/config/credentials in container
# The credentials.json file must be in this directory
# Format: /host/path/to/directory (directory containing credentials.json)
# Examples:
#   GOOGLE_PHOTOS_CREDENTIALS_DIR_HOST=/home/user/.config/google-photos
#   GOOGLE_PHOTOS_CREDENTIALS_DIR_HOST=/mnt/usb/credentials
# Default: ./config/credentials (project directory)
GOOGLE_PHOTOS_CREDENTIALS_DIR_HOST=./config/credentials

# ============================================
# Organization Policy
# ============================================

# Organization policy: date-type, date, or type-date
ORGANIZER_POLICY=date-type

# Dry-run mode: true or false
DRY_RUN=false

# ============================================
# Filesystem Configuration
# ============================================

# For Docker: use /var/www/html
# For local development: use /
FILESYSTEM_LOCAL_ROOT=/var/www/html

# Directory permissions (octal): 0755 = 493 decimal
FILESYSTEM_DEFAULT_DIR_PERMISSIONS=0755

# ============================================
# Messenger Configuration

# Async processing mode: true or false
# When true, messages are sent to Redis/RabbitMQ queue for parallel processing
# When false, messages are processed synchronously (one by one)
# Default: true
ASYNC_MODE=true

# ============================================

# For Docker with Redis (default):
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# For Docker with RabbitMQ (uncomment when using RabbitMQ profile):
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

# For local development (without Docker):
# MESSENGER_TRANSPORT_DSN=doctrine://default

# ============================================
# Messenger Retry Strategy Configuration
# ============================================

MESSENGER_MAX_RETRIES=3
MESSENGER_RETRY_DELAY=1000
MESSENGER_RETRY_MULTIPLIER=2
MESSENGER_RETRY_MAX_DELAY=10000

# ============================================
# Storage Configuration
# ============================================

# Storage DSN for source (reading files)
# Format: storage_type://location?credentials&options
# Examples:
#   SOURCE_STORAGE_DSN=local:///var/data/source
#   SOURCE_STORAGE_DSN=google-photos://album-id?client_id=xxx&client_secret=yyy
#   SOURCE_STORAGE_DSN=local:///path/to/dir?rate_limit_requests=100&rate_limit_per_seconds=60
# If not set, defaults to local storage using SOURCE_DIRECTORY
# SOURCE_STORAGE_DSN=

# Storage DSN for destination (writing organized files)
# Format: storage_type://location?credentials&options
# Examples:
#   DESTINATION_STORAGE_DSN=local:///var/data/destination
#   DESTINATION_STORAGE_DSN=google-photos://album-id?client_id=xxx&client_secret=yyy
#   DESTINATION_STORAGE_DSN=local:///path/to/dir?rate_limit_requests=100&rate_limit_per_seconds=60
# If not set, defaults to local storage using DESTINATION_DIRECTORY
# DESTINATION_STORAGE_DSN=

# ============================================
# Rate Limiting Configuration
# ============================================

# Rate limiting: number of requests allowed per time window
# Applied to all storage operations (read, write, scan, etc.)
# If not set, rate limiting is disabled
# If set in DSN, DSN values take precedence
# Default: not set (no rate limiting)
# RATE_LIMIT_REQUESTS=100

# Rate limiting: time window in seconds
# Example: RATE_LIMIT_REQUESTS=100 + RATE_LIMIT_PER_SECONDS=60 = 100 requests per 60 seconds
# Default: not set (no rate limiting)
# RATE_LIMIT_PER_SECONDS=60

# Rate limiting: burst limit (optional)
# Allows temporary bursts above the normal rate limit
# Example: RATE_LIMIT_REQUESTS=100 + RATE_LIMIT_BURST=150 = normal 100/sec, burst up to 150/sec
# Default: not set (burst equals RATE_LIMIT_REQUESTS)
# RATE_LIMIT_BURST=150

# Google Photos API Configuration
# Path to credentials.json file (INSIDE container, after volume mount)
# This is the path where credentials.json will be accessible in the container
# DO NOT change this unless you change the volume mount in docker-compose.yml
# Default: /var/www/html/config/credentials/credentials.json
# This path is INSIDE the container after volume mount
GOOGLE_PHOTOS_CREDENTIALS_PATH=/var/www/html/config/credentials/credentials.json

# Request full access scope (photoslibrary) instead of appendonly
# Set to true for full access, false for append-only
GOOGLE_PHOTOS_FULL_ACCESS=false


GOOGLE_PHOTOS_ACCESS_TOKEN=
GOOGLE_PHOTOS_ALBUM_ID=# File Compression Configuration
COMPRESSION_ENABLED=false
COMPRESSION_JPEG_MAX_PIXELS=75000000
COMPRESSION_PNG_MAX_PIXELS=200000000
COMPRESSION_VIDEO_MAX_SIZE_BYTES=10737418240

# ============================================
# Logging Configuration
# ============================================

# Enable/disable file logging (true/false)
# Set to false to disable file logging completely for better performance
LOG_FILE_ENABLED=true

# File logging level: DEBUG, INFO, WARNING, ERROR, or OFF to disable
# Higher levels = less logging = better performance
# DEBUG: all messages (slowest)
# INFO: informational messages and above
# WARNING: warnings and errors only
# ERROR: errors only
# OFF: disable file logging (same as LOG_FILE_ENABLED=false)
LOG_FILE_LEVEL=DEBUG

# Console logging level: DEBUG, INFO, WARNING, ERROR
# Controls what appears in stdout/stderr
LOG_CONSOLE_LEVEL=INFO

# ============================================
# Performance Tips
# ============================================
# For maximum performance, set:
# LOG_FILE_ENABLED=false
# or
# LOG_FILE_LEVEL=OFF
# LOG_CONSOLE_LEVEL=WARNING
#
# This will disable file logging and show only warnings/errors in console
