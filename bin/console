#!/usr/bin/env php
<?php

declare(strict_types=1);

use SortingPhotosByDate\Command\ScanFilesCommand;
use SortingPhotosByDate\Ports\FilesystemPort;
use SortingPhotosByDate\Ports\LoggerPort;
use SortingPhotosByDate\Ports\ScannerPort;
use Symfony\Component\Console\Application;
use Symfony\Component\DependencyInjection\ContainerBuilder;
use Symfony\Component\DependencyInjection\Loader\YamlFileLoader;
use Symfony\Component\Config\FileLocator;
use Symfony\Component\Messenger\MessageBusInterface;

require_once __DIR__.'/../vendor/autoload.php';

// Load DI container
$container = new ContainerBuilder();

// Set kernel.project_dir parameter
$container->setParameter('kernel.project_dir', dirname(__DIR__));

$loader = new YamlFileLoader($container, new FileLocator(__DIR__.'/../config'));
$loader->load('services.yaml');

// Load flysystem configuration
if (file_exists(__DIR__.'/../config/packages/flysystem.yaml')) {
    $loader->load('packages/flysystem.yaml');
}

// Set application parameters
$container->setParameter('app.destination_directory', getenv('DESTINATION_DIRECTORY') ?: '/var/data/destination');

// Compile container
$container->compile();

// Create SynchronousMessageBus manually after compilation
$messageBus = new \SortingPhotosByDate\Infrastructure\Messenger\SynchronousMessageBus($container);
$container->set(MessageBusInterface::class, $messageBus);

// Create console application
$application = new Application('File Sorter', '1.0.0');

// Register commands from container
foreach ($container->findTaggedServiceIds('console.command') as $id => $tags) {
    $command = $container->get($id);
    $application->add($command);
}

$application->run();
