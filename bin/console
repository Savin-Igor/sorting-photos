#!/usr/bin/env php
<?php

declare(strict_types=1);

use SortingPhotosByDate\Infrastructure\Config\ContainerFactory;
use Symfony\Component\Console\Application;
use Symfony\Component\Messenger\MessageBusInterface;

require_once __DIR__.'/../vendor/autoload.php';

// Build and configure DI container using ContainerFactory
$containerFactory = new ContainerFactory(dirname(__DIR__));
$container = $containerFactory->build();

// Set default destination directory if not set
if (!$container->hasParameter('app.destination_directory')) {
    $container->setParameter('app.destination_directory', getenv('DESTINATION_DIRECTORY') ?: '/var/data/destination');
}

// Create console application
$application = new Application('File Sorter', '1.0.0');

// Register commands from container
foreach ($container->findTaggedServiceIds('console.command') as $id => $tags) {
    $command = $container->get($id);
    $application->add($command);
}

$application->run();
